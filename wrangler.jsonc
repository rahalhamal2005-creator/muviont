{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muviont",
  "main": "public/_worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".next",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
